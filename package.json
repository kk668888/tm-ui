{
  "name": "tm-ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Vue 3 component library wrapping ant-design-vue with tm prefix",
  "main": "./dist/tm-ui.cjs.js",
  "module": "./dist/tm-ui.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/tm-ui.es.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/tm-ui.cjs.js"
      }
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite play",
    "build": "vue-tsc --noEmit && vite build",
    "admin:dev": "vite --config apps/admin/vite.config.ts",
    "admin:build": "vue-tsc -p apps/admin/tsconfig.json --noEmit && vite build --config apps/admin/vite.config.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "peerDependencies": {
    "ant-design-vue": "^4.0.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "@vitejs/plugin-vue": "^5.0.0",
    "ant-design-vue": "^4.1.0",
    "axios": "^1.9.0",
    "autoprefixer": "^10.5.0",
    "dayjs": "^1.11.20",
    "less": "^4.2.0",
    "pinia": "^2.3.1",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vitepress": "^1.0.0",
    "vue": "^3.4.0",
    "vue-i18n": "^9.14.4",
    "vue-router": "^4.5.1",
    "vue-tsc": "^2.0.0"
  }
}
